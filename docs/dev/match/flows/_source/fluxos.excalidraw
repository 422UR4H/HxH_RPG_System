      "updated": 1756864555241,
      "link": null,
      "locked": false,
      "text": "jogadores\nenviam as\nactions de\nseus\npersonagens",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "jogadores\nenviam as\nactions de seus personagens",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ntBtCN1Msb1w9DVdHoJrD",
      "type": "text",
      "x": 1090.3320303198886,
      "y": 3105.945197120848,
      "width": 203.39609297495085,
      "height": 225,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
