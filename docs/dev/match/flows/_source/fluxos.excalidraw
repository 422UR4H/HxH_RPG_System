    },
    {
      "id": "1yv3X63PjeVs4yZ8xf7RY",
      "type": "text",
      "x": -929.651415901968,
      "y": 2121.9142308206387,
      "width": 274.9996337890625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
