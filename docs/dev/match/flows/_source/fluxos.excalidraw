      "link": null,
      "locked": false,
      "text": "mestre clica\nno botão\n\"Iniciar Partida\"\n(na tela da partida)\ne confirma",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "mestre clica\nno botão\n\"Iniciar Partida\" (na tela da partida) e confirma",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "vzLF4wv0KjDwB5sxkwjmO",
      "type": "text",
      "x": -2699.3711067986865,
      "y": 484.8793574985741,
      "width": 151.11157676192286,
      "height": 150,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
