        {
          "id": "T7RuE7dZLLYT42irm8ihR",
          "type": "arrow"
        }
      ],
      "updated": 1771551239412,
      "link": null,
      "locked": false,
      "text": "se o mestre não\nocultar a action,\no usecase notifica\ntodos os clients",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "se o mestre não ocultar a action, o usecase notifica todos os clients",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "LkFHD8wGO9akqzeV1tze-",
      "type": "text",
      "x": 1107.8413821044555,
      "y": -2080.397162054427,
      "width": 124.48207500633347,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAE2",
      "roundness": null,
      "seed": 1627905452,
      "version": 4038,
      "versionNonce": 1716753243,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "T7RuE7dZLLYT42irm8ihR",
          "type": "arrow"
        }
      ],
      "updated": 1771443460833,
      "link": null,
      "locked": false,
      "text": "no futuro\ntalvez ele\nselecione\napenas os\nclients que\ndevem ser\nnotificados\nbaseado no\npersonagem",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "no futuro talvez ele selecione apenas os clients que devem ser notificados baseado no personagem",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "3-UsthwurzJ8RsE7SdbO2",
      "type": "text",
      "x": 593.8885437209142,
      "y": -1922.8609546399955,
      "width": 157.77830329214277,
      "height": 150,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAEA",
      "roundness": null,
      "seed": 766270133,
      "version": 3955,
      "versionNonce": 2061398011,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771443460833,
      "link": null,
      "locked": false,
      "text": "TurnEngine\nmove a action\nda ActionQueue\npara o Turno\natual e para\ncurrentAction",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TurnEngine move a action da ActionQueue para o Turno atual e para currentAction",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Lyk7QQcBMF-ilpgID76mW",
      "type": "text",
      "x": 638.032064059013,
      "y": -2282.9539551393736,
      "width": 174.4630728962005,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAEE",
      "roundness": null,
      "seed": 425255445,
