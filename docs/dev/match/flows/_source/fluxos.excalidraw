    {
      "id": "riWjvvmUIafg3TObW0buu",
      "type": "text",
      "x": 915.9432802639963,
      "y": -1084.7847833898286,
      "width": 1110.99853515625,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bC7",
      "roundness": null,
      "seed": 1155764657,
      "version": 1471,
      "versionNonce": 25154939,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "K7BWbzzzGgLHqgbAcScnS",
          "type": "arrow"
        }
      ],
      "updated": 1771443460836,
      "link": null,
      "locked": false,
      "text": "iniciativa precisa ser agnóstica da virada actionFree -> actionRace:\n- sempre que lido com iniciativa, penso nela como protagonista\n- mas olhando para esse cenário do Turno Livre, ninguém perceber pode impedir um combate de iniciar\n- percepção deve ser um recurso ainda mais genérico que iniciativa...\n-> ou seja, percept deve ser agnóstico de iniciativa, até porque vem antes!\n  -> se ninguém perceber, ninguém joga iniciativa e o(s) alvo(s) tem a chance de esquivar por reflexo\n  -> se apenas 1 perceber, ele pode rolar reflexo (iniciativa) para reagir\n    -> percebo que 1 já é suficiente para rolar iniciativa\n    - (até aqui não necessáriamente iniciou um combate)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "iniciativa precisa ser agnóstica da virada actionFree -> actionRace:\n- sempre que lido com iniciativa, penso nela como protagonista\n- mas olhando para esse cenário do Turno Livre, ninguém perceber pode impedir um combate de iniciar\n- percepção deve ser um recurso ainda mais genérico que iniciativa...\n-> ou seja, percept deve ser agnóstico de iniciativa, até porque vem antes!\n  -> se ninguém perceber, ninguém joga iniciativa e o(s) alvo(s) tem a chance de esquivar por reflexo\n  -> se apenas 1 perceber, ele pode rolar reflexo (iniciativa) para reagir\n    -> percebo que 1 já é suficiente para rolar iniciativa\n    - (até aqui não necessáriamente iniciou um combate)",
      "autoResize": true,
      "lineHeight": 1.25
    },
