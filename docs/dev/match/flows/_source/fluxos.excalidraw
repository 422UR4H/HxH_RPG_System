      "versionNonce": 270923100,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756864555241,
      "link": null,
      "locked": false,
      "text": "os jogadores podem\npré-setar/setar\na(s) próxima(s)\naction(s) (ou\ncancelar/alterar a\naction setada)\ndinamicamente, à\nqualquer momento,\nà partir daqui",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "os jogadores podem\npré-setar/setar\na(s) próxima(s)\naction(s) (ou cancelar/alterar a action setada) dinamicamente, à\nqualquer momento,\nà partir daqui",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Kh61HbTAgt2tk5q41rjdG",
      "type": "text",
      "x": 796.9556557188434,
      "y": 3612.32089165636,
      "width": 120.33702821433232,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
