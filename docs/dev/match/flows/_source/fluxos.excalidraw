      "versionNonce": 966639692,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777849397730,
      "link": null,
      "locked": false,
      "text": "talvez aqui\nos jogadores\ntambém\nprecisem\nconfirmar\n(como no lol)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "talvez aqui os jogadores também precisem confirmar (como no lol)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "--jgZcGyXWo1Yc7-JbJYx",
      "type": "text",
      "x": -2355.2032461587264,
      "y": 1283.4620707922243,
      "width": 269.2365767619229,
      "height": 100,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8JUZ",
