    {
      "id": "Lr_kP5FhMJVlMclLg70Qp",
      "type": "text",
      "x": 4345.663270372916,
      "y": -3743.8524114215006,
      "width": 802.9989624023438,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bDA",
      "roundness": null,
      "seed": 691453819,
      "version": 1014,
      "versionNonce": 988158005,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771445067614,
      "link": null,
      "locked": false,
      "text": "quando o mestre confirma, o sistema calcula as actions individualmente\ne verifica quais tiveram sucesso e/ou falha\n\nentão a action (e reactions) são enviadas para algum local\ne ficam esperando para serem processadas\n\nesse local pode ser a engine das actions\n\nquando o mestre confirmar o fim (quem não enviou reaction já era):\n    - a action engine \"colide\" todas elas, processando o resultado\n    - a match engine usa esse resultado para aplicar nos character_status\n    - todos os usuários são notificados do resultado",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "quando o mestre confirma, o sistema calcula as actions individualmente\ne verifica quais tiveram sucesso e/ou falha\n\nentão a action (e reactions) são enviadas para algum local\ne ficam esperando para serem processadas\n\nesse local pode ser a engine das actions\n\nquando o mestre confirmar o fim (quem não enviou reaction já era):\n    - a action engine \"colide\" todas elas, processando o resultado\n    - a match engine usa esse resultado para aplicar nos character_status\n    - todos os usuários são notificados do resultado",
      "autoResize": true,
      "lineHeight": 1.25
    },
