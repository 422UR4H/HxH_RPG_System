    {
      "id": "j0b563WqYYuUqcP8zZ0TJ",
      "type": "text",
      "x": 2618.0856833841394,
      "y": 4065.220295461114,
      "width": 378.75920712935545,
      "height": 58.07714040234309,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0c",
      "roundness": null,
      "seed": 11475360,
      "version": 797,
      "versionNonce": 1724556764,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756864555242,
      "link": null,
      "locked": false,
      "text": "se o próximo personagem a agir não tiver sua ação setada ainda, o mestre pode:\n    * esperar que o jogador envie sua action\n    * pular para a próxima ação setada\n    * pedir ao jogador que narre (indique) enquanto ele mesmo (mestre) seta\n\nobs.: talvez esta última opção não estará disponível na v0.0",
      "fontSize": 7.743618720312412,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "se o próximo personagem a agir não tiver sua ação setada ainda, o mestre pode:\n    * esperar que o jogador envie sua action\n    * pular para a próxima ação setada\n    * pedir ao jogador que narre (indique) enquanto ele mesmo (mestre) seta\n\nobs.: talvez esta última opção não estará disponível na v0.0",
      "autoResize": false,
      "lineHeight": 1.25
    },
