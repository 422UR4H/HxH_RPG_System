      "isDeleted": false,
      "boundElements": [],
      "updated": 1756864555241,
      "link": null,
      "locked": false,
      "text": "o mestre\nenvia as\nações dos\nNPCs",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "o mestre envia as ações dos NPCs",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "LzqCwdgcCYX_JwoU6VJvX",
      "type": "text",
      "x": 1084.0747486077646,
      "y": 3605.693554018726,
      "width": 227.38517669435055,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aSd",
      "roundness": null,
