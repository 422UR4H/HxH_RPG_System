        }
      ],
      "updated": 1756864555241,
      "link": null,
      "locked": false,
      "text": "A NÍVEL DE EXPERIÊNCIA,\nCOMO O MESTRE PODE SALVAR\nE ABRIR UMA AÇÃO AO FINALIZAR\nSUA EDIÇÃO, FAZ SENTIDO QUE ELE\nABRA A AÇÃO E ISSO DISPARE O\nFECHAMENTO DO TURNO",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A NÍVEL DE EXPERIÊNCIA,\nCOMO O MESTRE PODE SALVAR\nE ABRIR UMA AÇÃO AO FINALIZAR\nSUA EDIÇÃO, FAZ SENTIDO QUE ELE\nABRA A AÇÃO E ISSO DISPARE O\nFECHAMENTO DO TURNO",
      "autoResize": true,
      "lineHeight": 1.25
    },
