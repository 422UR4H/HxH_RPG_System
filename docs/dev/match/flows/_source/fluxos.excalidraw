      "isDeleted": false,
      "boundElements": [
        {
          "id": "d-K7iMHyWjSksHTd8z9NU",
          "type": "arrow"
        }
      ],
      "updated": 1756940325328,
      "link": null,
      "locked": false,
      "text": "o servidor vai\nrolando os dados\nde teste e\niniciativa/action_\nspeed para cada\naction que chega\ndos clients e\nreenviando para o\nclient do mestre",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "o servidor vai rolando os dados de teste e iniciativa/action_speed para cada action que chega dos clients e reenviando para o client do mestre",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Xyrh_dSSLlI87MCdVMGJA",
      "type": "text",
      "x": -2509.4699452149916,
      "y": 2202.939956183218,
      "width": 203.39609297495085,
      "height": 200,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
