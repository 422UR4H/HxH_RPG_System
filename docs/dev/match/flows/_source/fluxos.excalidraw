          "id": "DHt_RH_28MZDRW-YgDEvM",
          "type": "arrow"
        }
      ],
      "updated": 1756864555241,
      "link": null,
      "locked": false,
      "text": "uma barra com os\nícones dos\npersonagens\n(incluindo NPCs)\nindica os que ainda\nnão setaram sua ação",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "uma barra com os ícones dos personagens (incluindo NPCs) indica os que ainda não setaram sua ação",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ujVGU0ABbKUeHa3Jp3wK0",
      "type": "text",
      "x": 1363.963066294241,
      "y": 3769.4160692581017,
      "width": 229.71407209123896,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
