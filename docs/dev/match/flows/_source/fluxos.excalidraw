      "versionNonce": 756809915,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771443460826,
      "link": null,
      "locked": false,
      "text": "sistema instancia servidor\nweb-socket injetando\nreferências das fichas já\ncarregadas e inicializa\ncharacter_status",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "sistema instancia servidor web-socket injetando referências das fichas já carregadas e inicializa character_status",
      "autoResize": false,
      "lineHeight": 1.25
    },
