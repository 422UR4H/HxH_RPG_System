    {
      "id": "Fm7o2mI4NqBqNDTMbYt-Y",
      "type": "text",
      "x": 201.3972496201364,
      "y": 3584.8951465323116,
      "width": 235.0121816207447,
      "height": 275,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
