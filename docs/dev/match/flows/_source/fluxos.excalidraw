      "isDeleted": false,
      "boundElements": [
        {
          "id": "cPzV7Mfi-3zIDKS6qm_Py",
          "type": "arrow"
        }
      ],
      "updated": 1771443460828,
      "link": null,
      "locked": false,
      "text": "o uso de ren (até mesmo sem intenção de\natacar) pode provocar um combate.\numa presença forte pode abalar os outros,\npossibilitando outro(s) teste(s)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "o uso de ren (até mesmo sem intenção de atacar) pode provocar um combate.\numa presença forte pode abalar os outros, possibilitando outro(s) teste(s)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "zbcEzkKTjL5HMezB8d2Fm",
      "type": "text",
      "x": -1145.3319264862566,
      "y": 944.6497119797261,
      "width": 563.424226478418,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
