        }
      ],
      "updated": 1756940376370,
      "link": null,
      "locked": false,
      "text": "se alguma iniciativa for 2x\nmaior que a menor do turno,\no servidor notifica o client\ndo dono do personagem que\npode enviar outra action",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "se alguma iniciativa for 2x maior que a menor do turno, o servidor notifica o client do dono do personagem que pode enviar outra action",
      "autoResize": false,
      "lineHeight": 1.25
    },
