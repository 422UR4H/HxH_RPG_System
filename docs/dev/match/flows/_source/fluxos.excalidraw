        }
      ],
      "updated": 1771443460833,
      "link": null,
      "locked": false,
      "text": "-> Turno Livre\nou Disputado:\nMestre Confirma\na Action\n(após narração\nno fim do fluxo\nde abertura)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> Turno Livre ou Disputado:\nMestre Confirma a Action\n(após narração no fim do fluxo de abertura)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ShPnY8C4StA-Davzdupec",
