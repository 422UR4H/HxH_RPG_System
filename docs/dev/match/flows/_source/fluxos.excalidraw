      "versionNonce": 614146299,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "no9pLGu36-C2UnOOk9Um_",
          "type": "arrow"
        }
      ],
      "updated": 1771691832383,
      "link": null,
      "locked": false,
      "text": "se houver\ncloseTurn\nengatilhado, o\nusecase dispara\npersistência do\nturno",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "se houver closeTurn engatilhado, o usecase dispara persistência do turno",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "z8Cm6BuT-EHEt3_2JlTNY",
      "type": "text",
