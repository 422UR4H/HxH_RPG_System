      "locked": false,
      "text": "o mestre narra\no início da\npartida para\nos jogadores e\nclica no botão\n\"Iniciar Batalha\",\nque notifica o\nservidor",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "o mestre narra\no início da\npartida para\nos jogadores e clica no botão \"Iniciar Batalha\", que notifica o servidor",
      "autoResize": false,
      "lineHeight": 1.25
    },
