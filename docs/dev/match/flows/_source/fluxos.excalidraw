      ],
      "updated": 1756864555241,
      "link": null,
      "locked": false,
      "text": "abre uma caixa\npara edição, de\nforma que não\natrapalhe o mestre\nquando chegarem\nnovas actions",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "abre uma caixa\npara edição, de forma que não atrapalhe o mestre quando chegarem\nnovas actions",
      "autoResize": false,
      "lineHeight": 1.25
    },
