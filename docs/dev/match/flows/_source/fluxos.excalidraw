    {
      "id": "n2ba3GOUIwS8Wn84LDUo8",
      "type": "text",
      "x": -4381.707460526018,
      "y": 2471.509720593261,
      "width": 340.99951171875,
      "height": 350,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
