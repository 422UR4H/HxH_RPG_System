      "text": "se a action permitir uma resposta (ataque)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "se a action permitir uma resposta (ataque)",
