    {
      "id": "yMVxN24-qtZqO3oLaC-JY",
      "type": "text",
      "x": 3756.4304378531824,
      "y": 5434.366002156021,
      "width": 1693.7979736328125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4Z",
      "roundness": null,
      "seed": 396971431,
      "version": 842,
      "versionNonce": 889358161,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763847555177,
      "link": null,
      "locked": false,
      "text": "a nível de gameficação das partidas, os personagens precisam declarar que estão na postura \"em guarda\", estando prontos para ações defensivas ou evasivas.\nao entrar em batalha, o personaem pode entrar em uma postura ou outra, trazendo vantagens para as ações no domínio dessas posturas (diagrama acima).\nao atacar, o personagem entra - nem que seja por um instante - na postura ofensiva, o que \"abre sua guarda\" para possíveis ataques de adversários.\n- é claro que personagens mais fracos, em algum nível não conseguirão se aproveitar dessa pequena abertura...\n    mas é bom lembrar que o gon roubou a plaqueta do Hisoka nesse contexto!\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a nível de gameficação das partidas, os personagens precisam declarar que estão na postura \"em guarda\", estando prontos para ações defensivas ou evasivas.\nao entrar em batalha, o personaem pode entrar em uma postura ou outra, trazendo vantagens para as ações no domínio dessas posturas (diagrama acima).\nao atacar, o personagem entra - nem que seja por um instante - na postura ofensiva, o que \"abre sua guarda\" para possíveis ataques de adversários.\n- é claro que personagens mais fracos, em algum nível não conseguirão se aproveitar dessa pequena abertura...\n    mas é bom lembrar que o gon roubou a plaqueta do Hisoka nesse contexto!\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
