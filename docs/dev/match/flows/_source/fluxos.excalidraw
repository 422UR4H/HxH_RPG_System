      "seed": 504669178,
      "version": 3162,
      "versionNonce": 1186949595,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "_kQTPa_eCpkv73_rG21Sg",
          "type": "arrow"
        }
      ],
      "updated": 1771443460828,
      "link": null,
      "locked": false,
      "text": "uma action de ataque que alveja um personagem\nsomente deveria iniciar uma batalha se gera reações\nem cadeia. ex.: o alvo não consegue reagir e\ndesmaia ou morre no primeiro golpe e ninguém reage.\nisso se enquadra mais em um assassinato sem batalha",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "uma action de ataque que alveja um personagem somente deveria iniciar uma batalha se gera reações em cadeia. ex.: o alvo não consegue reagir e desmaia ou morre no primeiro golpe e ninguém reage.\nisso se enquadra mais em um assassinato sem batalha",
      "autoResize": false,
      "lineHeight": 1.25
    },
