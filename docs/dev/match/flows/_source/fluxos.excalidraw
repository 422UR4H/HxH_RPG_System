      "versionNonce": 977905595,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771443460829,
      "link": null,
      "locked": false,
      "text": "* se o mesmo jogador enviar outra action, no front, ela não entra como ação default\n  (na caixa de edição)",
      "fontSize": 13.13135151219501,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* se o mesmo jogador enviar outra action, no front, ela não entra como ação default\n  (na caixa de edição)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
