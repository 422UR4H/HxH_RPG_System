      "seed": 2082336578,
      "version": 3926,
      "versionNonce": 2133081115,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771443460826,
      "link": null,
      "locked": false,
      "text": "envia as fichas para os\nclients dos respectivos\ndonos e um lote com\ntodas elas para o mestre",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "envia as fichas para os clients dos respectivos donos e um lote com todas elas para o mestre",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "8pEdN1-RoUZ904_9uhSW0",
      "type": "text",
      "x": -1741.9933742028616,
      "y": 747.0545034952368,
      "width": 288.3142558695059,
      "height": 125,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
