      "locked": false,
      "text": "o front deve enviar a ação do jogador\nou seja, se ele clicou em \"investida\"\nessa categoria escolhida deve ser enviada\no back deve propagar e persistir\n-> \"investida\" não deve existir como action",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "o front deve enviar a ação do jogador\nou seja, se ele clicou em \"investida\"\nessa categoria escolhida deve ser enviada\no back deve propagar e persistir\n-> \"investida\" não deve existir como action",
      "autoResize": true,
      "lineHeight": 1.25
    },
